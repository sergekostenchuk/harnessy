{
  "name": "harnessy",
  "private": true,
  "version": "0.1.0-dev",
  "description": "Harnessy — окно владельца над командой ИИ-агентов. Новое ядро: packages/* (TypeScript); окно и оболочка: ui/",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node packages/projects/src/test-helpers.ts run",
    "build": "npm run build --workspaces --if-present",
    "dist": "npm --prefix ui/desktop run dist"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.20.5"
  }
}
