{
  "name": "harnessy-desktop",
  "productName": "Harnessy-alpha",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Harnessy alpha: автономная оболочка и встроенный движок",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:site": "python3 ../deploy/build.py",
    "prepare:engine": "node build-engine.mjs",
    "prepare:dist": "npm run prepare:site && npm run prepare:engine",
    "dist": "npm run prepare:dist && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "dist:x64": "npm run prepare:dist && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  }
}
